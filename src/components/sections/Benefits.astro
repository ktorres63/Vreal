---
import {
  MonitorSmartphone,
  Globe,
  AudioLines,
} from "@lucide/astro";

const features = [
  {
    title: "Ultra-HD Realism",
    description:
      "Resolución 8K con trazado de rayos en tiempo real para una fidelidad visual que desafía la realidad.",
    icon: MonitorSmartphone,
    color: "text-blue-400",
  },
  {
    title: "Global Access",
    description:
      "Más de 500 destinos escaneados con fotogrametría láser, desde ciudades icónicas hasta rincones vírgenes.",
    icon: Globe,
    color: "text-violet-300",
  },
  {
    title: "Interactive Guides",
    description:
      "Acompañamiento por IA en tiempo real que narra la historia y secretos de cada ubicación en tu idioma.",
    icon: AudioLines,
    color: "text-cyan-300",
  },
];
---

<section class="relative overflow-hidden bg-[#06071B] py-32">
  <!-- Background glow -->
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(59,130,246,0.12),transparent_40%)]"
  >
  </div>

  <div
    class="absolute top-0 left-0 w-full h-32 bg-linear-to-b from-[#06071B] to-transparent pointer-events-none z-10"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-6 md:px-12">
    <!-- Header -->
    <div class="text-center">
      <h2
        class="text-4xl font-black tracking-tight text-white md:text-6xl"
      >
        ¿Por qué elegir
        <span
          class="bg-linear-to-r from-cyan-400 to-violet-400 bg-clip-text text-transparent"
        >
          VReal?
        </span>
      </h2>

      <p
        class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-zinc-400 md:text-xl"
      >
        Tecnología de vanguardia para una inmersión total.
      </p>
    </div>

    <!-- Cards -->
    <div class="mt-20 grid gap-8 md:grid-cols-3">
      {
        features.map((feature) => {
          const Icon = feature.icon;

          return (
            <article
              class="group relative overflow-hidden rounded-3xl border border-white/10 bg-white/3 p-8 transition-all duration-300 hover:-translate-y-2 hover:border-cyan-400/30 hover:bg-white/5"
            >
              <!-- Glow -->
              <div
                class="absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
              >
                <div
                  class="absolute -top-16 left-1/2 h-40 w-40 -translate-x-1/2 rounded-full bg-cyan-500/10 blur-3xl"
                >
                </div>
              </div>

              <!-- Content -->
              <div class="relative">
                <!-- Icon container -->
                <div
                  class="flex h-18 w-18 items-center justify-center rounded-2xl border border-white/10 bg-white/4"
                >
                  <Icon class={`h-8 w-8 ${feature.color}`} />
                </div>

                <!-- Title -->
                <h3 class="mt-8 text-3xl font-bold text-white">
                  {feature.title}
                </h3>

                <!-- Description -->
                <p
                  class="mt-6 text-lg leading-relaxed text-zinc-400"
                >
                  {feature.description}
                </p>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
