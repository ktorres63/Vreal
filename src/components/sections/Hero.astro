---
import { Mouse } from "@lucide/astro";
const title = "Expande los";
const highlight = "límites";
const rest = "de tu realidad";
---

<section id="hero" class="">
  <!-- Scroll indicator -->
  <div
    class="scroll-indicator absolute bottom-10 left-1/2 -translate-x-1/2 z-30 flex flex-col items-center"
  >
    <p class="text-xs tracking-[4px] text-white/70 mb-4">
      DESLIZA PARA EXPLORAR
    </p>

    <Mouse size={32} stroke-width={1.5} class="text-white/80" />
  </div>

  <!-- Fondo con experiencia VR -->
  <div class="masked-img absolute inset-0">
    <img
      src="/images/bgCatedralVR.png"
      alt="Experiencia VReal"
      class="w-full h-full object-cover"
    />

    <div class="dark-overlay absolute inset-0 bg-black opacity-0"></div>
    <!-- efecto de profundidad -->
    <div class="absolute inset-0 bg-black/20"></div>
  </div>

  <!-- Contenido final -->
  <div
    class="hero-content absolute inset-0 z-20 flex items-center justify-center text-center opacity-0"
  >
    <div class="px-6">
      <p class="text-sm tracking-[5px] text-gray-300 mb-6">
        THE FUTURE IS HERE
      </p>

      <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold text-white">
        {title}

        <br />

        <span
          class="bg-gradient-to-r from-purple-400 to-blue-400 bg-clip-text text-transparent"
        >
          {highlight}
        </span>

        {rest}
      </h1>

      <p class="mt-8 max-w-xl mx-auto text-gray-300 text-lg">
        Explora destinos antes de visitarlos. Vive experiencias inmersivas con
        VReal.
      </p>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initHero() {
    gsap.to(".scroll-indicator", {
      y: 15,
      duration: 1.2,
      repeat: -1,
      yoyo: true,
      ease: "power1.inOut",
    });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#hero",
        start: "top top",
        end: "+=3000",
        scrub: 1.5,
        pin: true,
      },
    });

    tl.to(".masked-img", {
      maskSize: "830%",
      webkitMaskSize: "500%",
      duration: 3,
      ease: "power2.inOut",
    })

      .to(".masked-img img", {
        scale: 1.15,
        duration: 1,
      })

      .to(".dark-overlay", {
        opacity: 0.7,
        duration: 1,
      })

      .to(".scroll-indicator", {
        opacity: 0,
        y: 20,
        duration: 0.8,
      })

      .to(".hero-content", {
        opacity: 1,
        y: 0,
        duration: 1,
      });
  }

  initHero();
</script>
