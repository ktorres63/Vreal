---
import {
  Cpu,
  ShieldCheck,
  Accessibility,
  Sparkles,
  Rocket,
  Eye,
  Building2,
} from "@lucide/astro";

const values = [
  {
    title: "Innovación Constante",
    description:
      "Exploramos siempre las últimas actualizaciones del metaverso y hardware de Meta para ofrecer lo mejor.",
    icon: Cpu,
    color: "text-cyan-400",
  },
  {
    title: "Seguridad y Compromiso",
    description:
      "Especialmente en el sector minero, priorizamos la integridad humana mediante simulaciones precisas.",
    icon: ShieldCheck,
    color: "text-emerald-400",
  },
  {
    title: "Accesibilidad",
    description:
      "Creemos que la tecnología de punta debe estar al alcance de todos, desde el estudiante hasta la gran empresa.",
    icon: Building2,
    color: "text-violet-300",
  },
  {
    title: "Excelencia en la Experiencia",
    description:
      "Cada interacción con nuestros lentes debe ser fluida, realista e inolvidable.",
    icon: Sparkles,
    color: "text-pink-400",
  },
];
---

<section class="relative overflow-hidden bg-[#06071B] py-24">
  <!-- Top fade (recibe el degradado del Hero) -->
  <div
    class="absolute top-0 left-0 w-full h-32 bg-linear-to-b from-[#06071B] to-transparent pointer-events-none z-10"
  >
  </div>

  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(42,63,255,0.18),transparent_55%)]"
  >
  </div>
  <div class="mb-20 text-center">
    <h2 class="text-4xl md:text-6xl font-black tracking-tight text-white">
      Nosotros
    </h2>
  </div>

  <div class="relative mx-auto max-w-9xl md:px-12">
    <div class="grid gap-8 lg:grid-cols-2">
      <!-- Mission -->
      <article
        class="group relative overflow-hidden rounded-3xl border border-white/10 bg-white/2 p-10 backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-cyan-400/30"
      >
        <!-- Glow -->
        <div
          class="absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        >
          <div
            class="absolute -top-20 left-1/2 h-40 w-40 -translate-x-1/2 rounded-full bg-cyan-500/10 blur-3xl"
          >
          </div>
        </div>

        <div class="relative">
          <!-- Icon -->
          <div
            class="flex h-16 w-16 items-center justify-center rounded-full border border-white/10 bg-white/5"
          >
            <Rocket class="h-7 w-7 text-cyan-400" />
          </div>

          <!-- Title -->
          <h2 class="mt-8 text-5xl font-black text-white">Misión</h2>

          <!-- Text -->
          <p class="mt-8 max-w-2xl text-xl leading-relaxed text-zinc-300">
            Empoderar a diversos sectores de la sociedad mediante el acceso a
            tecnología de realidad virtual de alta fidelidad, ofreciendo
            soluciones innovadoras que superen las barreras geográficas, físicas
            y de seguridad, permitiendo a nuestros usuarios "estar" donde
            siempre han soñado o donde su trabajo lo requiera
          </p>
        </div>
      </article>

      <!-- Vision -->
      <article
        class="group relative overflow-hidden rounded-3xl border border-white/10 bg-white/2 p-10 backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-cyan-400/30"
      >
        <!-- Glow -->
        <div
          class="absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        >
          <div
            class="absolute -top-20 left-1/2 h-40 w-40 -translate-x-1/2 rounded-full bg-cyan-500/10 blur-3xl"
          >
          </div>
        </div>

        <div class="relative">
          <!-- Icon -->
          <div
            class="flex h-16 w-16 items-center justify-center rounded-full border border-white/10 bg-white/5"
          >
            <Eye class="h-7 w-7 text-violet-300" />
          </div>

          <!-- Title -->
          <h2 class="mt-8 text-5xl font-black text-white">Visión</h2>

          <!-- Text -->
          <p class="mt-8 max-w-2xl text-xl leading-relaxed text-zinc-300">
            Convertirnos para el año 2031 en el referente principal de servicios
            de realidad virtual en el sur del país, siendo reconocidos como el
            socio estratégico clave para la transformación digital en los
            sectores de turismo, minería y educación a nivel nacional.
          </p>
        </div>
      </article>
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-4">
      {
        values.map((value) => {
          const Icon = value.icon;

          return (
            <article class="group relative overflow-hidden rounded-3xl border border-white/10 bg-white/2 p-10 backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-cyan-400/30">
              {/* Glow effect */}
              <div class="absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100">
                <div class="absolute -top-20 left-1/2 h-40 w-40 -translate-x-1/2 rounded-full bg-cyan-500/10 blur-3xl" />
              </div>

              {/* Icon */}
              <div class="relative flex justify-center">
                <div class="flex h-20 w-20 items-center justify-center rounded-full border border-white/10 bg-white/5 shadow-[0_0_30px_rgba(255,255,255,0.03)]">
                  <Icon class={`h-8 w-8 ${value.color}`} />
                </div>
              </div>

              {/* Content */}
              <div class="relative mt-8 text-center">
                <h3 class="text-3xl font-semibold text-white">{value.title}</h3>

                <p class="mx-auto mt-5 max-w-sm text-lg leading-relaxed text-zinc-400">
                  {value.description}
                </p>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
